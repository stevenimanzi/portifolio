# ==============================================================================
# Hostinger Apache / LiteSpeed Configuration for Steven Imanzi Portfolio & API
# ==============================================================================

DirectoryIndex index.html index.php
Options -Indexes

# MIME types & Charsets
AddType "application/xml; charset=UTF-8" .xml
AddType "text/plain; charset=UTF-8" .txt

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Allow direct execution of PHP API endpoints
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Serve existing static files or directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Single Page Application (SPA) fallback for React Router
  RewriteRule ^ index.html [L]
</IfModule>

# Caching, Compression & Security Headers
<IfModule mod_headers.c>
  # Never cache HTML so users always get the latest bundle references
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Sitemap & robots freshness
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
    Header set X-Robots-Tag "all"
  </FilesMatch>

  # Long cache for hashed static assets
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|pdf|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
