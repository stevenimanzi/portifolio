rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only the site owner. Sign-in also has to be on this exact account.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'stivenimanzi1@gmail.com';
    }

    // Contact-form messages: anyone can add one (validated); only the owner can read or manage them.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'read'])
                    && request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt', 'read'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 150
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.read == false;
      allow read, update, delete: if isAdmin();
    }

    // Page views: anyone can add one (validated); only the owner can read them.
    match /visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['path', 'referrer', 'newVisitor', 'device', 'lang', 'country', 'city', 'lat', 'lng', 'createdAt'])
                    && request.resource.data.keys().hasAll(['path', 'referrer', 'newVisitor', 'device', 'lang', 'createdAt'])
                    && request.resource.data.path is string
                    && request.resource.data.path.size() > 0 && request.resource.data.path.size() <= 200
                    && request.resource.data.referrer is string && request.resource.data.referrer.size() <= 200
                    && request.resource.data.newVisitor is bool
                    && request.resource.data.device in ['mobile', 'tablet', 'desktop']
                    && request.resource.data.lang is string && request.resource.data.lang.size() <= 20
                    && (!('country' in request.resource.data) || (request.resource.data.country is string && request.resource.data.country.size() <= 3))
                    && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 100))
                    && (!('lat' in request.resource.data) || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
                    && (!('lng' in request.resource.data) || (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180))
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Website content edited from the dashboard: everyone can read it, only the owner can change it.
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
